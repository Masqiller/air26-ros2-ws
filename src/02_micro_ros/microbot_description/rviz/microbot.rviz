Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/Range
      Name: US Front
      Enabled: true
      Topic:
        Value: /ultrasonic/front
      Color: 255; 80; 80
    - Class: rviz_default_plugins/Range
      Name: US Left
      Enabled: true
      Topic:
        Value: /ultrasonic/left
      Color: 80; 255; 80
    - Class: rviz_default_plugins/Range
      Name: US Right
      Enabled: true
      Topic:
        Value: /ultrasonic/right
      Color: 80; 80; 255
    - Class: rviz_default_plugins/Marker
      Name: Camera Data
      Enabled: true
      Topic:
        Value: /camera/viz
    - Class: rviz_default_plugins/Image
      Name: Camera Feed
      Enabled: true
      Topic:
        Value: /camera/image_raw
    - Class: rviz_default_plugins/Image
      Name: AprilTag Detections
      Enabled: true
      Topic:
        Value: /apriltag/image
    - Class: rviz_default_plugins/Odometry
      Name: Wheel Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 100
      Shape:
        Value: Arrow
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.6
      Yaw: 0.6
