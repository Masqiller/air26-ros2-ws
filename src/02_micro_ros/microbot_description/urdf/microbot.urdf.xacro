<?xml version="1.0"?>
<!-- AIR26 — the real 2WD differential bot.
     Ported from the raju_bot CAD model (https://github.com/Masqiller/raju_bot_ws):
       * RAJU.stl chassis, 2 driven wheels, front caster ball, camera_link  (from raju_bot)
     and extended for THIS robot's sensors:
       * 3x HC-SR04 ultrasonic links: us_front / us_left / us_right         (added)
       * camera optical frame + ESP32-CAM placement kept from the CAD       (added/kept)

     Names are deliberately chosen to match the firmware and our nodes:
       - wheel joints : base_back_left_wheel_joint / base_back_right_wheel_joint
                        (exactly what the ESP32-S3 publishes on /joint_states, so the
                         wheels really spin in RViz from the encoders)
       - range frames : us_front / us_left / us_right
                        (exactly the Range.header.frame_id the firmware sends, so the
                         RViz Range cones resolve; each frame's +X points outward)
       - camera frame : camera_link  (camera_viz paints its marker here)

     FRAME LAYOUT — read before moving anything:
     the CAD authors base_link rotated +90 deg yaw w.r.t. base_footprint, so in base_link
     X is lateral (the wheel axis) and Y is longitudinal. base_footprint is the sane frame:
     +X = forward, +Y = left. Therefore the odom chain is
         odom -> base_footprint -> base_link
     and wheel_odometry publishes odom->base_footprint (NOT base_link, which would make the
     robot appear to drive sideways). Sensors we add hang off base_footprint for that reason.

     Chassis extents (mesh, scaled to m): 0.233 wide (Y) x 0.180 long (X) x 0.143 tall. -->
<robot name="microbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== materials ===================== -->
  <material name="chassis_blue"><color rgba="0.20 0.35 0.75 1"/></material>
  <material name="black">       <color rgba="0.05 0.05 0.05 1"/></material>
  <material name="gray">        <color rgba="0.50 0.50 0.50 1"/></material>
  <material name="us_blue">     <color rgba="0.10 0.40 0.95 1"/></material>

  <!-- ===================== geometry constants ===================== -->
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_length" value="0.02"/>
  <!-- wheel centres in base_link: X = lateral (+X is LEFT once base_link's yaw is applied) -->
  <xacro:property name="wheel_x" value="0.1165"/>   <!-- half track  -> separation 0.233 m -->
  <xacro:property name="wheel_y" value="0.053"/>    <!-- longitudinal (behind the centre) -->
  <xacro:property name="wheel_z" value="-0.037"/>

  <!-- ===================== ground-projection root ===================== -->
  <link name="base_footprint"/>

  <!-- ===================== chassis (CAD mesh) ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- mesh authored in mm -> scale to metres -->
        <mesh filename="file://$(find microbot_description)/meshes/RAJU.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find microbot_description)/meshes/RAJU.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- the CAD's +90 deg yaw: base_link X becomes base_footprint Y -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.072" rpy="0 0 1.5708"/>
  </joint>

  <!-- ===================== driven wheels ===================== -->
  <!-- axis 1 0 0 = base_link X = base_footprint +Y (left), so a POSITIVE joint angle
       rolls the robot FORWARD on both sides (standard diff-drive convention). -->
  <xacro:macro name="drive_wheel" params="link joint px">
    <link name="${link}">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.570796 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 1.570796 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${joint}" type="continuous">
      <parent link="base_link"/>
      <child link="${link}"/>
      <origin xyz="${px} ${wheel_y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
    </joint>
  </xacro:macro>

  <!-- joint names must match the ESP32-S3 /joint_states publisher -->
  <xacro:drive_wheel link="base_back_left_wheel"  joint="base_back_left_wheel_joint"
                     px="${ wheel_x}"/>
  <xacro:drive_wheel link="base_back_right_wheel" joint="base_back_right_wheel_joint"
                     px="${-wheel_x}"/>

  <!-- ===================== front caster ball ===================== -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="0.009"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.009"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0 -0.045 -0.063" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ultrasonics (HC-SR04) =====================
       Placed on the CAD's REAL sensor openings, not by eye. The chassis has three pairs
       of 16 mm transducer holes (26.32 mm apart, i.e. +/-13.16 mm), measured from the
       mesh in base_link/mm:
         front wall (-Y, outer y=-90) : holes at X=+/-13.16, Z=13.91   -> us_front
         left  wall (+X, outer x=+99) : holes at Y=-11.83/-38.15, Z=20 -> us_left
         right wall (-X, outer x=-99) : holes at Y=-11.83/-38.15, Z=20 -> us_right
       Each link is parented to base_link (the frame the mesh is authored in) so the
       numbers are exactly the CAD's, and each frame's +X points OUT of its wall, which
       is the direction the RViz Range cone follows:
         us_front  +X = base_link -Y = base_footprint +X (forward)
         us_left   +X = base_link +X = base_footprint +Y (left)
         us_right  +X = base_link -X = base_footprint -Y (right)
       The link origin sits on the OUTER wall surface, i.e. the real measuring face, so
       reported ranges start at the sensor face. The two transducer cylinders are modelled
       and poke through the two holes; the PCB sits inside the shell behind them. -->
  <xacro:property name="us_pitch" value="0.01316"/>   <!-- half of the 26.32 mm hole spacing -->

  <xacro:macro name="ultrasonic" params="name px py pz yaw">
    <link name="${name}">
      <!-- PCB, tucked inside the shell behind the wall -->
      <visual>
        <origin xyz="-0.012 0 0"/>
        <geometry><box size="0.008 0.045 0.020"/></geometry>
        <material name="us_blue"/>
      </visual>
      <!-- the two 16 mm transducers, seated in the two holes -->
      <visual>
        <origin xyz="-0.004 ${ us_pitch} 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.008" length="0.014"/></geometry>
        <material name="us_blue"/>
      </visual>
      <visual>
        <origin xyz="-0.004 ${-us_pitch} 0" rpy="0 1.5708 0"/>
        <geometry><cylinder radius="0.008" length="0.014"/></geometry>
        <material name="us_blue"/>
      </visual>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${px} ${py} ${pz}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <!-- front: on the -Y wall, so the sensor's +X must face -Y  -> yaw -90 deg -->
  <xacro:ultrasonic name="us_front" px="0"      py="-0.090" pz="0.0139" yaw="-1.5708"/>
  <!-- left: on the +X wall, sensor +X already faces +X       -> yaw 0 -->
  <xacro:ultrasonic name="us_left"  px="0.099"  py="-0.025" pz="0.0200" yaw="0"/>
  <!-- right: on the -X wall, sensor +X must face -X          -> yaw 180 deg -->
  <xacro:ultrasonic name="us_right" px="-0.099" py="-0.025" pz="0.0200" yaw="3.14159"/>

  <!-- ===================== ESP32-CAM =====================
       The CAD has no camera window, so the camera goes where the module physically fits:
       on the front wall, centred (base_link X=0) and below the front ultrasonic, at the
       height raju_bot's own URDF used (base_link Z=-10.27 mm). Flush with the outer face
       (y=-90) and looking forward: camera_link +X = base_link -Y = base_footprint +X. -->
  <link name="camera_link">
    <visual>                                   <!-- module body, behind the wall -->
      <origin xyz="-0.008 0 0"/>
      <geometry><box size="0.010 0.027 0.027"/></geometry>
      <material name="black"/>
    </visual>
    <visual>                                   <!-- lens barrel, through the wall -->
      <origin xyz="-0.001 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0055" length="0.008"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="-0.008 0 0"/>
      <geometry><box size="0.010 0.027 0.027"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="5.21e-7" ixy="0" ixz="0" iyy="2.08e-7" iyz="0" izz="5.21e-7"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0 -0.090 -0.01027" rpy="0 0 -1.5708"/>
  </joint>

  <!-- optical frame (REP-103: Z forward, X right, Y down) for image geometry -->
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

</robot>
